rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images uploaded from the Admin Panel (js/main.js reads
    // these public URLs for the live Menu; only a signed-in admin may
    // upload/replace/delete them).
    match /menu-images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
